# ── PostgreSQL ────────────────────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_NAME=chat_platform
PG_USER=chat_user
PG_PASSWORD=StrongPass123
PG_POOL_MIN=2
PG_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=chat-media

# ── Server ────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=9000
BRIDGE_PORT=8000

# ── Auth ──────────────────────────────────────────────────────
SESSION_TTL_HOURS=24

# ── Media ─────────────────────────────────────────────────────
MAX_FILE_MB=20

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
